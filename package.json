{
  "name": "@try-works/dsh-stt",
  "version": "0.2.2",
  "description": "Multi-model local speech-to-text for the DSH Web composer: Whistle and Voz, user-selectable, with lazy per-model download. Ships as a DSH bundle.",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./src/*": "./src/*",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "src",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "speech-to-text",
    "speech-recognition",
    "transcription",
    "voice-input",
    "dictation",
    "on-device",
    "local-inference",
    "whistle",
    "voz",
    "cactus"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-experimental-client-ui-voice-input"
      ],
      "external": []
    }
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.3",
    "@desert-ant-labs/voz": "3.6.0",
    "onnxruntime-node": "^1.30.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/try-works/dsh-stt.git"
  },
  "homepage": "https://github.com/try-works/dsh-stt#readme",
  "bugs": {
    "url": "https://github.com/try-works/dsh-stt/issues"
  }
}
